# Production environment variables for OmniDesk
# ================================================
# 这是部署 OmniDesk 生产/离线环境所需的全部环境变量模板。
#
# 使用步骤:
#   1. 复制本文件为 .env.production:
#      cp .env.production.example .env.production
#   2. 填写所有 <CHANGE-TO-...> / <GENERATE-...> / <YOUR_...> 占位符为真实值。
#   3. 永不要把 .env.production 提交到版本控制。
#
# 字段分组:
#   - PostgreSQL / Redis: 数据库与缓存凭证
#   - Django: 应用密钥 + 允许的主机/CORS
#   - Docker 镜像标签: 部署哪个版本的镜像
#   - Celery: 异步任务队列
#   - RAGFlow: 知识库检索服务(含其独立 MySQL 的密码)
#   - 智能助手 LLM 端点种子: seed_llm_endpoint 命令的可选覆盖变量
#   - Mineru: 文档解析服务(可选,不配置 = 该功能禁用,其他功能不受影响)
#
# 占位符说明:
#   - <CHANGE-TO-STRONG-PASSWORD>: 至少 16 字符的强密码
#   - <CHANGE-TO-DB-USER>: 数据库用户名
#   - <GENERATE-NEW-SECRET-KEY>: 用 `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"` 生成
#   - <YOUR_MINERU_API_KEY>: 从 Mineru 服务获取的真实 API Key;留空 = 禁用文档解析

# ── PostgreSQL ──────────────────────────────────────────────
# Database name (safe to keep)
POSTGRES_DB=omni_desk
# Database username (must be set)
POSTGRES_USER=<CHANGE-TO-DB-USER>
# Database password — use a strong password (min 16 chars)
POSTGRES_PASSWORD=<CHANGE-TO-STRONG-PASSWORD>
# Host and port of the PostgreSQL service (match docker-compose service name)
DB_HOST=db
DB_PORT=5432

# ── Django ──────────────────────────────────────────────────
# Django secret key — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<GENERATE-NEW-SECRET-KEY>
# Must be False in production
DEBUG=False
# Comma-separated list of allowed hostnames/IPs
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# Comma-separated list of trusted CSRF origins
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# USE_HTTPS: true=启用 HTTPS 全套安全加固;false=纯 HTTP 部署(默认,内网常用)
#   - true:  nginx/反代必须正确转发 X-Forwarded-Proto 头
#   - false: SECURE_SSL_REDIRECT/HSTS 关闭,允许 cookie 在 HTTP 下传输
USE_HTTPS=false

# ── Smoke 测试专用账号 (P0-5) ────────────────────────────
# 用于部署冒烟"阶段 12"真实账密登录链路,覆盖 argon2 hasher(production 与 test 的 MD5 差异)。
# 此账号必须由 manage.py create_smoke_user 创建,is_staff=False,仅能 /api/auth/login/
# 创建后:把下面两个变量同步到 GH Actions secrets(smoke-tests job 用),
# 部署现场只在 .env.production 里填实际值,不要提交到 git。
# 注意:填值请用 sed 原地替换占位行(见 docs/technical/40-smoke-test-coverage.md),
# 勿用 ">>" 追加——追加会与占位行构成同名重复变量,smoke 脚本解析出非法 JSON。
SMOKE_TEST_USER=
SMOKE_TEST_PASSWORD=

# ── Docker Image Tags ───────────────────────────────────────
# 使用语义版本标签(参见 deployment/docker/VERSION),不要用 :latest
# CI (build-and-push-images.yml) 会在 main 分支推送时打 v{VERSION} 标签
BACKEND_IMAGE_TAG=v0.4.0
FRONTEND_IMAGE_TAG=v0.4.0

# ── 固定 Compose 项目 / 卷 / 运行时身份 ────────────────────────
# 目的:让不同离线包目录(alpha/beta/rc/stable/hotfix)复用同一生产 Compose 项目与卷,
# 升级时不会因为包目录名变化触发 docker compose 把数据遗弃在孤儿项目里。
#
# 字段语义:
#   CHANNEL                    当前包所属渠道(alpha|beta|rc|stable|hotfix)
#   COMPOSE_PROJECT_NAME       docker compose 项目名(网络/容器前缀)
#   OMNIDESK_POSTGRES_VOLUME   Postgres 数据卷的固定 external name
#   OMNIDESK_MEDIA_VOLUME      Django media 卷的固定 external name
#   OMNIDESK_BACKUP_ROOT       数据库 / 媒体备份在宿主机上的统一根目录
#   OMNIDESK_RUNTIME_ROOT      运行时持久化目录(logs/upgrade.log 等)
#
# 模板默认值基于 CHANNEL=rc;首次部署可改 CHANNEL 让 ${CHANNEL:-rc} 自动重算,
# 或直接覆盖下面任一字段。docker-compose.offline.yml 通过显式 name: 引用这些值。
CHANNEL=rc
COMPOSE_PROJECT_NAME=omnidesk-${CHANNEL:-rc}
OMNIDESK_POSTGRES_VOLUME=omnidesk-${CHANNEL:-rc}-postgres-data
OMNIDESK_MEDIA_VOLUME=omnidesk-${CHANNEL:-rc}-media-data
OMNIDESK_BACKUP_ROOT=/opt/omnidesk/backups
OMNIDESK_RUNTIME_ROOT=/opt/omnidesk/runtime

# ── Redis ───────────────────────────────────────────────────
# Redis password — must match the --requirepass in docker-compose
REDIS_PASSWORD=<CHANGE-TO-STRONG-PASSWORD>
REDIS_HOST=redis
REDIS_PORT=6379

# ── Celery ──────────────────────────────────────────────────
# These use REDIS_PASSWORD above — no need to change the format
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0
CACHE_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/1

# ── RAGFlow (知识库检索服务) ────────────────────────────────
# RAGFlow 需要独立的 MySQL 数据库。
# RAGFLOW_MYSQL_PASSWORD: ragflow-mysql 容器使用的密码(至少 16 字符)
RAGFLOW_MYSQL_PASSWORD=<CHANGE-TO-STRONG-PASSWORD>
# RAGFLOW_PORT: RAGFlow Web UI 暴露的端口(默认 9380)
RAGFLOW_PORT=9380
# RAGFLOW_API_ENDPOINT: RAGFlow API 端点(容器内通信用 http://ragflow:80)
# 部署后在 RAGFlow Web UI (http://server-ip:9380) 中创建账号,生成 API Key
RAGFLOW_API_ENDPOINT=http://ragflow:80
# RAGFLOW_API_KEY: 从 RAGFlow Web UI 生成的 API Key
# RAGFLOW_API_KEY=ragflow-xxxxx
# SMART_ASSISTANT_DATASET_ID: 在 RAGFlow 中创建 dataset 后填入其 ID
# SMART_ASSISTANT_DATASET_ID=dataset-xxxxx

# ── 智能助手 LLM 端点种子配置(可选)───────────────────────────
# deploy_offline.sh / deploy.sh 的 migrate 步骤会自动执行 seed_llm_endpoint 命令,
# 为智能助手创建默认 LLM 端点(修复空库时"所有 LLM 端点均不可用"的问题)。
# 以下变量全部可选,不设置即使用默认值;LlmEndpoint 表已有记录时命令自动跳过(幂等)。
# 注意:容器内 localhost 指向容器自身;若 Ollama 装在宿主机,请改用宿主机内网 IP,
# 例如 SEED_LLM_API_ENDPOINT=http://<宿主机IP>:11434/v1
# SEED_LLM_API_ENDPOINT=http://localhost:11434/v1
# SEED_LLM_MODEL=qwen2.5:7b
# SEED_LLM_API_KEY=

# ── Mineru (文档解析服务,可选) ────────────────────────────────
# 离线/内网环境应指向内网 Mineru 服务。
# 不配置或留空 = 文档解析功能不可用,不影响其他功能。
# production.py 会在 KEY 为占位符时报错;留空或填真实 KEY 都可以。
# MINERU_API_KEY=<YOUR_MINERU_API_KEY>
# MINERU_API_URL=http://mineru-service:8000/api/v1
